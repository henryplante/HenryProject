SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/clearpath
SPRING_DATASOURCE_USERNAME=clearpath
SPRING_DATASOURCE_PASSWORD=clearpath
# Neon (from repo root: `neon deploy` writes these to `.env.local`):
# DATABASE_URL=postgresql://…-pooler…/neondb?sslmode=require   # Hikari / runtime (pooled)
# DATABASE_URL_UNPOOLED=postgresql://…/neondb?sslmode=require  # Flyway migrations (direct)
# DATABASE_URL_POOLED=…  # alias for DATABASE_URL when only the pooled name is set
SESSION_SECRET=dev-change-me-in-production
SESSION_COOKIE_SECURE=false
SERVER_PORT=8080
PORT=8080
SEED_ON_STARTUP=false
